# Safe systemd-wrapper parameters. No secrets belong here.
BOT_SERVICE_VENUE=testnet
BOT_SERVICE_EXECUTION=dry
BOT_SERVICE_SYMBOLS=SOLUSDT
# Additional prediction symbols remain read-only and never start workers.
BOT_PREDICTION_SHADOW_SYMBOLS=SOLUSDT,ETHUSDT
# Opt in only after reconciling pre-existing holdings and their cost basis.
BOT_SERVICE_AUTO_OCO_HOLDINGS=0
BOT_SERVICE_EXTRA_ARGS=
# Must remain below deploy/mybot.service TimeoutStopSec=45.
SUPERVISOR_STOP_TIMEOUT_SEC=30
