# Purpose: schedule the trading digest at 08:00 Asia/Almaty every morning.
[Unit]
Description=Schedule Ladder Dragon daily Telegram trading digest

[Timer]
OnCalendar=*-*-* 08:00:00 Asia/Almaty
Persistent=true
AccuracySec=1m
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
