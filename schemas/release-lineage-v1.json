{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/potekhinskill/Ladder-Dragon/schemas/release-lineage-v1.json",
  "title": "Ladder Dragon release lineage baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_version",
    "baseline_tag",
    "baseline_commit",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "baseline_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy": {
      "const": "strict_linear_releases_after_baseline"
    }
  }
}
